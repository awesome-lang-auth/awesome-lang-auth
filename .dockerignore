# Keep the Docker build context equal to the old wiki/ folder: no git
# metadata, and nothing the image builds itself. node_modules from the host
# would also overwrite the ones `npm ci` installs in the Alpine builder.
.git
node_modules
build
.docusaurus

# The build reads no .env (docker compose reads it on the host, for PORT and
# COMPOSE_PROJECT_NAME), so keep it out of the image.
.env
