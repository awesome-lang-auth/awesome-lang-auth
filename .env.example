# ──────────────────────────────────────────────────────────────────────────────
# awesome-node-auth wiki — AI Assistant configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values, then rebuild:
#   cp .env.example .env && npm run build
#
# All variables are injected at BUILD TIME via Docusaurus customFields.
# Never commit .env — it is listed in .gitignore.
# For GitHub Actions, add these as repository secrets and expose them in the
# build step of .github/workflows/docs.yml (already wired in the workflow).
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# The OpenAI Responses API endpoint (supports MCP server tool use).
# Use v1/responses to enable MCP servers and other tool integrations.
AI_LLM_ENDPOINT=https://api.openai.com/v1/responses

# ── Model & Sampling ─────────────────────────────────────────────────────────
#
# These settings are now proxied. When using the proxy (mcp-server), it is 
# recommended to configure these on the server-side (.env) instead.
# If provided here, they will be sent to the proxy, which will then forward them.
AI_MODEL=gpt-4o-mini


# ── Sampling ──────────────────────────────────────────────────────────────────

# Controls randomness (0.0 = deterministic, 1.0 = very random, 2.0 = maximum).
# Recommended range for a doc assistant: 0.2 – 0.5
# Leave empty to use the model's default.
AI_TEMPERATURE=0.3

# Maximum number of tokens the model may generate in a single reply.
# Sent as `max_output_tokens` to the Responses API.
# Leave empty to use the model's default (often 4096).
# Increase for detailed code examples; decrease to keep replies concise.
AI_MAX_TOKENS=2048

# ── Security model note ───────────────────────────────────────────────────────

# MCP tools, MCP Authorization Bearer token, and system instructions are
# injected server-side by mcp-server /tools/ai-proxy.
# Keep secrets and tool wiring ONLY in mcp-server/.env.

# Base URL of the REST server that hosts the account area API.
# When the wiki static files are served by the same Express server as the MCP
# server (recommended), leave this empty — all API calls use relative paths.
# When the wiki is hosted on a separate domain (e.g. GitHub Pages), set this
# to the full origin of the REST server so the browser can reach it via CORS.
# Example: ACCOUNT_API_URL=https://mcp.example.com
# ACCOUNT_API_URL=

# ── Google Analytics 4 (optional) ────────────────────────────────────────────

# GA4 Measurement ID — enables @docusaurus/plugin-google-gtag at build time.
# Obtain from Google Analytics → Admin → Data streams → Web → Measurement ID.
# Leave empty to disable analytics entirely.
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
