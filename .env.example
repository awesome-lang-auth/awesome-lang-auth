# ──────────────────────────────────────────────────────────────────────────────
# awesome-lang-auth site — optional docker compose settings
# ──────────────────────────────────────────────────────────────────────────────
# The site build needs no environment variable and reads no .env file. Only
# docker compose reads .env, from the folder of docker-compose.yml, to fill in
# the values below. To set one, copy this file to .env next to
# docker-compose.yml:
#   cp .env.example .env
# Never commit .env — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Host port (docker compose only) ──────────────────────────────────────────

# Host port the container publishes (default 3000). docker compose reads it
# from this file for docker-compose.yml; the site itself does not.
# PORT=3000

# ── Compose project name (docker compose only) ───────────────────────────────

# On a host where the container was started from another checkout, set this to
# that project (README → Deploy, step 1) so later `up`/`down`/`logs` target it.
# COMPOSE_PROJECT_NAME=wiki
